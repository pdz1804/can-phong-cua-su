{
  "name": "can-phong-cua-su",
  "private": true,
  "version": "1.0.0",
  "description": "Căn phòng của Su: a walkable 3D room of memories, a 20/10 gift.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-private.mjs dist",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:private": "node scripts/check-private.mjs src",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/three": "0.170.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.17.0",
    "globals": "15.15.0",
    "lint-staged": "15.5.2",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "2.1.9"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run check:private",
    "commit-msg": "npx --no -- commitlint --edit \"$1\"",
    "pre-push": "npm run typecheck && npm test"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{css,html,json,md,yml}": [
      "prettier --check"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
